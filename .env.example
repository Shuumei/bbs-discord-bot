# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
# Optional: Set DISCORD_GUILD_ID to instantly register slash commands to your test server without waiting for global cache
DISCORD_GUILD_ID=

# AI Provider Configuration
# Supported: openai or gemini (using OpenAI compatibility endpoint)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_or_gemini_api_key_here
# If using official OpenAI, leave OPENAI_BASE_URL empty or use: https://api.openai.com/v1
# If using Google Gemini via OpenAI API compatibility, use: https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
# Model name: e.g. gpt-4o-mini (for OpenAI) or gemini-1.5-flash / gemini-2.0-flash (for Gemini)
AI_MODEL=gpt-4o-mini

# BBS Guild & News System
# Discord Channel ID where scheduled Bleach & BBS news updates will be posted
NEWS_CHANNEL_ID=
# Cron schedule for news broadcast (default: every day at 10:00 AM)
NEWS_CRON_SCHEDULE=0 10 * * *
