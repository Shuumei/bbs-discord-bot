    "openai": "^7.15.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
